# MarketSentinel - Locked Environment Variables
DATABASE_URL=postgresql://marketsentinel:marketsentinel@postgres:5432/marketsentinel
REDIS_URL=redis://redis:6379/0
KAFKA_BROKERS=redpanda:9092
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
LLM_API_KEY=
NEWS_API_KEY=
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_BASE_URL=

# Market Data Provider Selection (simulator | live)
MARKET_DATA_PROVIDER=simulator

# Embedding Configuration (Locked: sentence-transformers/all-MiniLM-L6-v2, 384 dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Simulation Configuration
SIM_SYMBOLS=TCS,INFY,RELIANCE,HDFCBANK,ICICIBANK,SBIN,ITC,LT,BHARTIARTL,TATAMOTORS
SIM_SCENARIO=NORMAL
SIM_SCENARIO_INTERVAL_SECONDS=30
